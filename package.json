{
  "name": "write-down-and-scan-it",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "build": "node scripts/set-db-provider.mjs && prisma generate && tsx scripts/build-demo.ts && tsx scripts/prepare-db.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "seed": "tsx prisma/seed.ts",
    "setup": "node scripts/set-db-provider.mjs && prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "verify": "tsx scripts/verify-flow.ts",
    "ocr:check": "tsx scripts/check-ocr.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dev:lan": "next dev -H 0.0.0.0",
    "demo:build": "tsx scripts/build-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^6.1.0",
    "@vercel/blob": "^2.8.0",
    "jsqr": "^1.4.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
