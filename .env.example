# ─── Database ─────────────────────────────────────────────────────────────────
# `npm run db:up` starts a local PostgreSQL 16 cluster inside .pgdata/ and prints
# this line. Nothing here talks to a hosted database by default.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/awc_dev?schema=public"

# Used by the integration tests only. Never point this at a database you care about:
# the test setup truncates it.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/awc_dev_test?schema=public"

# ─── Extraction provider ──────────────────────────────────────────────────────
# "mock" (default) runs the whole workflow offline with fixed demo scenarios and
# no credentials. "anthropic" is inert unless ANTHROPIC_API_KEY is also set.
EXTRACTION_PROVIDER="mock"
# ANTHROPIC_API_KEY=

# ─── Decision rules (see docs/safety-and-decision-rules.md) ───────────────────
# Below this confidence a candidate needs human review, whatever the provider claims.
CONFIDENCE_THRESHOLD="0.90"
# Above this quantity a line needs review — guards a misread "1" as "100".
MAX_LINE_QUANTITY="50"
# What to do when the requested quantity exceeds stock on hand:
#   allow_with_discrepancy  record the withdrawal and open a discrepancy case (default)
#   block                   refuse the confirmation and route to supply review
NEGATIVE_STOCK_POLICY="allow_with_discrepancy"
# Whether a nurse may ever confirm a controlled or high-risk line themselves.
# Leave false. Setting it true removes a safety control.
RESTRICTED_SELF_CONFIRM="false"
# Optimistic-locking retries before a confirmation fails rather than half-applying.
CONFIRM_MAX_RETRIES="3"

# ─── Visual recognition (see docs/visual-recognition.md) ─────────────────────
# Recognising items from photographs of the items themselves, learned from photos
# people take here. It can never move stock: a line identified by sight is always
# "needs review", however many examples agree with it.
#
# Off entirely:
# VISUAL_RECOGNITION="off"
#
# Which embedding provider turns a photo into a vector:
#   unset / anything else  the built-in colour-and-shape fingerprint. No dependency,
#                          no download, works anywhere. Recognises the same pack
#                          photographed the same way; does not know what a syringe is.
#   transformers           CLIP or SigLIP via transformers.js, on CPU, free and local.
#                          Needs: npm install @huggingface/transformers
# EMBEDDING_PROVIDER="transformers"
# VISION_MODEL="Xenova/clip-vit-base-patch32"
# VISION_MODEL_DIMENSIONS="512"
#
# Thresholds. THESE ARE PROVIDER-SPECIFIC: the defaults are measured against the
# built-in descriptor, and a cosine of 0.80 means something quite different under
# CLIP. Switching providers re-teaches the index from scratch anyway — retune here
# at the same time.
# Below this, a stored photo is not evidence of anything.
VISION_MATCH_FLOOR="0.72"
# At or above this, and clear of the runner-up, recognition reads as settled.
VISION_CONFIDENT_AT="0.84"
# Two items scoring within this of each other are not separable by sight. The app
# says so and offers both rather than picking one.
VISION_CONFUSABLE_MARGIN="0.05"
# Active example photos per item per location. This cap IS the plateau, made
# explicit: past it, the most redundant photo is retired to make room.
VISION_MAX_EXAMPLES="12"
# Fewer examples than this reads as "learning" rather than "good".
VISION_CONFIDENT_EXAMPLES="3"
# After this many days an example is down-weighted and flagged — packaging changes.
VISION_STALE_AFTER_DAYS="365"
VISION_STALE_WEIGHT="0.9"
# Overrules before an example quarantines itself.
VISION_OVERRULE_LIMIT="3"

# ─── Photo storage ────────────────────────────────────────────────────────────
# Unset  → photos are written to .data/uploads on local disk (fine for local dev).
# Set    → photos go to Vercel Blob. Vercel sets this itself when you add
#          Storage → Blob to the project. REQUIRED on Vercel: its disk is ephemeral.
# BLOB_READ_WRITE_TOKEN=

# ─── Uploads and image access ─────────────────────────────────────────────────
MAX_IMAGE_BYTES="12582912"
IMAGE_URL_TTL_SECONDS="300"
# Signs image access tokens and session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-change-me"

# ─── Demo seed ────────────────────────────────────────────────────────────────
# The shared password for the seeded demo accounts. Development only.
DEMO_PASSWORD="demo1234"
