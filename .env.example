# ─── Reading handwriting ──────────────────────────────────────────────────────
# Leave unset to run the whole flow against bundled demo fixtures (no network, no
# cost). Set it to read real handwriting with claude-opus-5 vision.
ANTHROPIC_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite by default - zero setup, file on disk, perfect for local dev.
DATABASE_URL="file:./dev.db"
#
# On Vercel (or any serverless host) use Postgres instead. The disk there is
# ephemeral and per-instance, so a SQLite file would silently reset. The provider in
# prisma/schema.prisma is switched automatically to match this URL at build time.
# DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# ─── Photo storage ────────────────────────────────────────────────────────────
# Unset  -> photos are written to .data/uploads on local disk (fine for local dev).
# Set    -> photos go to Vercel Blob. REQUIRED on Vercel, for the same reason as above.
# BLOB_READ_WRITE_TOKEN=
